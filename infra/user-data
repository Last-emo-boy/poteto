#cloud-config
hostname: ovh-paas
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true
users:
  - name: ubuntu
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - REPLACE_WITH_YOUR_SSH_PUBLIC_KEY
package_update: false
