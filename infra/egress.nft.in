destroy table inet ovh_paas
table inet ovh_paas {
    chain qemu_output {
        type filter hook output priority -10; policy accept;
        meta skuid @UID@ ct state established,related accept
        meta skuid @UID@ ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4, @HOST_IPV4@/32 } counter reject
        meta skuid @UID@ meta nfproto ipv6 counter reject
    }
}
