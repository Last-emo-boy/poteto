[Unit]
Description=Independent bounded application log collection
After=docker.service paas-publisher-api.service
Requires=docker.service

[Service]
WorkingDirectory=/opt/paas-publisher
Environment=PAAS_DATA=/var/lib/paas-publisher
Environment=PAAS_BACKEND_CONFIG=/etc/paas-publisher/backend.json
UMask=0007
ExecStart=/opt/paas-publisher/.venv/bin/python -m publisher.worker --logs-only
Restart=on-failure
RestartSec=3
TimeoutStopSec=90
KillMode=mixed
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
